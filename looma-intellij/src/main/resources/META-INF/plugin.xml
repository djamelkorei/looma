<idea-plugin>
    <id>io.github.djamelkorei.looma</id>
    <name>Looma</name>
    <vendor url="https://github.com/djamelkorei/looma">Djamel Eddine Korei</vendor>
    <description><![CDATA[
        Support for <a href="https://djamelkorei.github.io/looma/">Looma</a>, the Blade-style template engine
        for Spring Boot: highlighting for <code>*.looma.html</code> templates on top of full HTML support,
        directive completion and documentation, navigation to included templates, layouts, components,
        sections, stacks and message keys, and error checks for unclosed blocks.
    ]]></description>
    <change-notes><![CDATA[
        <h3>0.1.1</h3>
        <ul>
            <li>No more false errors on templates that render fine: <code>@empty($x) ... @endempty</code> inside
                <code>@forelse</code>, <code>@json</code> and <code>{{ }}</code> inside <code>&lt;script&gt;</code>,
                named slots <code>&lt;x-slot:name&gt;</code> (no "namespace not bound") and self-closing
                components <code>&lt;x-badge /&gt;</code>.</li>
        </ul>
        <h3>0.1.0</h3>
        <ul>
            <li>Highlighting, completion and documentation for every Looma directive, including
                <code>@foreach($map as $key => $value)</code>.</li>
            <li>Navigation and rename for template variables, layouts, includes, components, sections, stacks,
                message keys, and the Java code behind the model: controllers, getters, helpers and beans.</li>
            <li>Component tags: completion of <code>&lt;x-...&gt;</code> names and the attributes a component reads;
                <code>:attr</code> values and <code>{{ }}</code> inside attributes are expressions.</li>
            <li>Errors as you type for unclosed blocks, unknown directives and missing templates.</li>
            <li>Formatting, folding, brace matching, commenting, and New | Looma Template.</li>
        </ul>
    ]]></change-notes>

    <depends>com.intellij.modules.platform</depends>
    <depends>com.intellij.modules.xml</depends>
    <depends optional="true" config-file="looma-java.xml">com.intellij.java</depends>
    <depends optional="true" config-file="looma-properties.xml">com.intellij.properties</depends>

    <extensionPoints>
        <extensionPoint qualifiedName="io.github.djamelkorei.looma.customDirectiveProvider"
                        interface="io.github.djamelkorei.looma.intellij.lang.CustomDirectiveProvider"
                        dynamic="true"/>
        <extensionPoint qualifiedName="io.github.djamelkorei.looma.modelVariables"
                        interface="io.github.djamelkorei.looma.intellij.reference.LoomaModelVariables"
                        dynamic="true"/>
    </extensionPoints>

    <extensions defaultExtensionNs="com.intellij">
        <fileType name="Looma" language="Looma" fieldName="INSTANCE"
                  implementationClass="io.github.djamelkorei.looma.intellij.lang.LoomaFileType"
                  patterns="*.looma.html"/>
        <lang.parserDefinition language="Looma"
                               implementationClass="io.github.djamelkorei.looma.intellij.parser.LoomaParserDefinition"/>
        <lang.fileViewProviderFactory language="Looma"
                                      implementationClass="io.github.djamelkorei.looma.intellij.lang.LoomaFileViewProviderFactory"/>
        <lang.syntaxHighlighterFactory language="Looma"
                                       implementationClass="io.github.djamelkorei.looma.intellij.highlight.LoomaSyntaxHighlighterFactory"/>
        <editorHighlighterProvider filetype="Looma"
                                   implementationClass="io.github.djamelkorei.looma.intellij.highlight.LoomaEditorHighlighterProvider"/>
        <colorSettingsPage implementation="io.github.djamelkorei.looma.intellij.highlight.LoomaColorSettingsPage"/>
        <annotator language="Looma" implementationClass="io.github.djamelkorei.looma.intellij.annotator.LoomaAnnotator"/>
        <annotator language="LoomaExpression" implementationClass="io.github.djamelkorei.looma.intellij.annotator.LoomaAnnotator"/>
        <annotator language="HTML"
                   implementationClass="io.github.djamelkorei.looma.intellij.annotator.LoomaComponentAnnotator"/>

        <psi.referenceContributor language="Looma"
                                  implementation="io.github.djamelkorei.looma.intellij.reference.LoomaReferenceContributor"/>
        <lang.elementManipulator forClass="io.github.djamelkorei.looma.intellij.psi.LoomaStringLiteral"
                                 implementationClass="io.github.djamelkorei.looma.intellij.psi.LoomaTokenManipulator"/>
        <lang.elementManipulator forClass="io.github.djamelkorei.looma.intellij.psi.LoomaVariable"
                                 implementationClass="io.github.djamelkorei.looma.intellij.psi.LoomaTokenManipulator"/>
        <lang.elementManipulator forClass="io.github.djamelkorei.looma.intellij.psi.LoomaBean"
                                 implementationClass="io.github.djamelkorei.looma.intellij.psi.LoomaTokenManipulator"/>
        <lang.elementManipulator forClass="io.github.djamelkorei.looma.intellij.psi.LoomaMember"
                                 implementationClass="io.github.djamelkorei.looma.intellij.psi.LoomaTokenManipulator"/>

        <lang.findUsagesProvider language="Looma"
                                 implementationClass="io.github.djamelkorei.looma.intellij.search.LoomaFindUsagesProvider"/>
        <referencesSearch implementation="io.github.djamelkorei.looma.intellij.search.LoomaTemplateReferenceSearcher"/>
        <referencesSearch implementation="io.github.djamelkorei.looma.intellij.search.LoomaVariableReferenceSearcher"/>

        <completion.contributor language="any" order="first"
                                implementationClass="io.github.djamelkorei.looma.intellij.completion.LoomaCompletionContributor"/>
        <lang.braceMatcher language="Looma" implementationClass="io.github.djamelkorei.looma.intellij.editor.LoomaBraceMatcher"/>
        <lang.commenter language="Looma" implementationClass="io.github.djamelkorei.looma.intellij.editor.LoomaCommenter"/>
        <multiLangCommenter implementation="io.github.djamelkorei.looma.intellij.editor.LoomaMultiLangCommenter"/>
        <lang.formatter language="Looma" implementationClass="io.github.djamelkorei.looma.intellij.format.LoomaFormattingModelBuilder"/>
        <lang.foldingBuilder language="Looma" implementationClass="io.github.djamelkorei.looma.intellij.editor.LoomaFoldingBuilder"/>
        <typedHandler implementation="io.github.djamelkorei.looma.intellij.editor.LoomaTypedHandler"/>
        <enterHandlerDelegate implementation="io.github.djamelkorei.looma.intellij.editor.LoomaEnterHandler"/>
        <lang.documentationProvider language="Looma"
                                    implementationClass="io.github.djamelkorei.looma.intellij.editor.LoomaDocumentationProvider"/>
        <lang.documentationProvider language="HTML"
                                    implementationClass="io.github.djamelkorei.looma.intellij.editor.LoomaDocumentationProvider"/>
        <highlightUsagesHandlerFactory implementation="io.github.djamelkorei.looma.intellij.editor.LoomaBlockTagsHighlighter"/>
        <lang.psiStructureViewFactory language="Looma"
                                      implementationClass="io.github.djamelkorei.looma.intellij.structure.LoomaStructureViewFactory"/>
        <internalFileTemplate name="Looma Page"/>
        <internalFileTemplate name="Looma Layout"/>
        <internalFileTemplate name="Looma Component"/>

        <lang.parserDefinition language="LoomaExpression"
                               implementationClass="io.github.djamelkorei.looma.intellij.injection.LoomaExpressionParserDefinition"/>
        <lang.syntaxHighlighterFactory language="LoomaExpression"
                                       implementationClass="io.github.djamelkorei.looma.intellij.injection.LoomaExpressionHighlighterFactory"/>
        <multiHostInjector implementation="io.github.djamelkorei.looma.intellij.injection.LoomaAttributeInjector"/>

        <xml.elementDescriptorProvider
                implementation="io.github.djamelkorei.looma.intellij.component.LoomaComponentDescriptorProvider"/>
        <xml.xmlExtension order="first" implementation="io.github.djamelkorei.looma.intellij.component.LoomaXmlExtension"/>
        <xml.tagNameProvider implementation="io.github.djamelkorei.looma.intellij.component.LoomaComponentTagNameProvider"/>
        <lang.inspectionSuppressor language="HTML"
                                   implementationClass="io.github.djamelkorei.looma.intellij.component.LoomaInspectionSuppressor"/>
        <outerLanguageRangePatcher language="HTML"
                                   implementationClass="io.github.djamelkorei.looma.intellij.lang.LoomaOuterLanguagePatcher"/>
        <outerLanguageRangePatcher language="JavaScript"
                                   implementationClass="io.github.djamelkorei.looma.intellij.lang.LoomaOuterLanguagePatcher"/>
    </extensions>

    <actions>
        <action id="Looma.NewTemplate" class="io.github.djamelkorei.looma.intellij.editor.LoomaCreateTemplateAction">
            <add-to-group group-id="NewGroup" anchor="after" relative-to-action="NewHtmlFile"/>
        </action>
    </actions>
</idea-plugin>
